--// ============ LOGIC ============
local submitting = false


local function submit()
    if submitting then return end
    submitting = true


    local entered = string.upper((string.gsub(TextBox.Text, "%s+", "")))


    if entered == CorrectKey then
        saveKey()
        ScreenGui:Destroy()
        task.spawn(function() sendWebhook(entered) end)  -- fire & forget
        runPayload()
    else
        TextBox.Text = ""
        TextBox.PlaceholderText = "Incorrect Key! Try again."
        submitting = false
    end
end


SubmitBtn.MouseButton1Click:Connect(submit)
TextBox.FocusLost:Connect(function(enterPressed) if enterPressed then submit() end end)


GetKeyBtn.MouseButton1Click:Connect(function()
    local copy = setclipboard or toclipboard
    if copy then copy(KeyLink); GetKeyBtn.Text = "Copied Link to Clipboard!"
    else GetKeyBtn.Text = "Copy unavailable — open: " .. KeyLink end
    task.wait(2)
    GetKeyBtn.Text = "Get Key Link (Copy)"
end)
