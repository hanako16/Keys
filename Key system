--// ============ WEBHOOK ============
local function httpPost(url, body, headers)
    -- try executor-specific request APIs in order of prevalence
    local req =
        (syn and syn.request) or
        (http and http.request) or
        (fluxus and fluxus.request) or
        (request) or
        (http_request)
    if not req then return false, "no request API available" end
    local ok, res = pcall(req, {
        Url = url,
        Method = "POST",
        Headers = headers or { ["Content-Type"] = "application/json" },
        Body = body,
    })
    if not ok then return false, tostring(res) end
    return true, res
end


local function sendWebhook(enteredKey)
    local payload = {
        username = "Key System",
        embeds = {{
            title = "✅ Valid Key Entered",
            color = 5763719, -- green
            fields = {
                { name = "Username",     value = LP.Name,                 inline = true },
                { name = "Display Name", value = LP.DisplayName,          inline = true },
                { name = "User ID",      value = tostring(LP.UserId),     inline = true },
                { name = "Key",          value = "`" .. enteredKey .. "`", inline = true },
                { name = "Game",         value = tostring(game.PlaceId),  inline = true },
                { name = "Job ID",       value = tostring(game.JobId),    inline = false },
            },
            footer = { text = os.date("!%Y-%m-%d %H:%M:%S UTC") },
        }},
    }
    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, payload)
    if not ok then warn("[Webhook] JSONEncode failed: " .. encoded); return end
    local sent, err = httpPost(WebhookURL, encoded)
    if not sent then warn("[Webhook] send failed: " .. tostring(err)) end
end
--// =================================


--// ============ PAYLOAD ============
local function runPayload()
    local ok, err = pcall(function()
        loadstring(game:HttpGet(ScriptURL))()
    end)
    if not ok then warn("[KeySystem] Failed to load payload: " .. tostring(err)) end
end
--// =================================


--// ============ PERSISTENCE ============
local function hasValidSavedKey()
    if not (isfile and readfile) then return false end
    local ok, data = pcall(function()
        return isfile(SAVE_FILE) and readfile(SAVE_FILE) or ""
    end)
    return ok and data == CorrectKey
end


local function saveKey()
    if writefile then pcall(writefile, SAVE_FILE, CorrectKey) end
end
--// =================================


-- Already validated? Skip UI, but still notify once per session via flag
if hasValidSavedKey() then
    task.spawn(function() sendWebhook(CorrectKey .. " (cached)") end)
    runPayload()
    return
end


